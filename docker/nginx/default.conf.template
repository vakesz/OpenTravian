# No nginx version in the Server header or on error pages.
server_tokens off;

# Brute-force and abuse throttle: POSTs to login, registration, OAuth and the support form
# share a per-client budget (20 per minute, burst 10). $request_uri is the original URI, so
# the internal redirect to /index.php does not count every other game POST.
map "$request_method $request_uri" $travian_auth_key {
    default "";
    "~^POST (/|/index\.php|/login(\.php)?|/homepage(/[^?]*)?|/oauth/[^?]*|/support/ticket/?)(\?.*)?$" $binary_remote_addr;
}
limit_req_zone $travian_auth_key zone=travian_auth:10m rate=20r/m;

# Unknown Host headers never reach PHP. The names below come from
# TRAVIAN_ALLOWED_HOSTS (see 15-travian-allowed-hosts.envsh).
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${TRAVIAN_ALLOWED_HOSTS};
    root /travian/game/deployment/public;
    index index.php;
    # Nothing uploads files: forms and JSON bodies are small.
    client_max_body_size 1m;
    limit_req zone=travian_auth burst=10 nodelay;
    limit_req_status 429;
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $php_backend php:9000;
    # admin.php and setup.php. A variable, like $php_backend, so Docker DNS
    # is re-resolved after the php container is recreated.
    set $php_long php:9001;

    # Client IP. REMOTE_ADDR is only rewritten from X-Forwarded-For when the
    # connection comes from TRAVIAN_TRUSTED_PROXY (a single address or CIDR,
    # rendered by the nginx image's envsubst templating). The default trusts
    # nothing that can reach the published port.
    set_real_ip_from ${TRAVIAN_TRUSTED_PROXY};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    # Self-hosted assets only. 'unsafe-inline' stays until inline scripts and styles are
    # removed; the OAuth provider origins are listed because a form POST that redirects to
    # the provider is checked against form-action.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' data: blob:; connect-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self' https://accounts.google.com https://www.facebook.com https://appleid.apple.com" always;
    fastcgi_buffer_size 64k;
    fastcgi_buffers 16 64k;
    fastcgi_busy_buffers_size 512k;

    # Compose uses this to distinguish a loaded nginx configuration from a
    # running PHP application. It has no player-facing representation.
    location = /healthz {
        access_log off;
        return 204;
    }

    # FPM exposes these on its private port for the PHP healthcheck and
    # operator diagnostics. They must never be reachable over HTTP.
    location = /fpm-ping {
        return 404;
    }

    location = /fpm-status {
        return 404;
    }

    # Metrics are served only by the internal listener below (port 9145, never published).
    location = /metrics {
        return 404;
    }

    location = /metrics.php {
        return 404;
    }

    location ^~ /gpack/ {
        alias /travian/assets/gpack/;
        access_log off;
        expires 30d;

        # Static text only: build-time .gz siblings first, on-the-fly gzip for the
        # rest. Dynamic HTML is deliberately not compressed (BREACH vs CSRF tokens).
        gzip_static on;
        gzip on;
        gzip_vary on;
        gzip_types text/css application/javascript image/svg+xml application/json;

        # registry.php and any other script must never be served as source.
        location ~* \.(?:php|phtml|phar|inc)$ {
            return 404;
        }
    }

    # Everything under /api/ goes to the API front controller; nothing is read
    # from services/api on disk. The more specific legacy routes below win by
    # longest-prefix match. ^~ keeps the \.php$ regex location out of /api/.
    location ^~ /api/ {
        rewrite ^/api(/.*)$ $1 break;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /travian/services/api/index.php;
        fastcgi_param REQUEST_URI $uri$is_args$args;
        fastcgi_pass $php_backend;
    }

    # Legacy game endpoints. api_legacy.php owns the list of routes and hands every
    # other /api/v1/ request to the API front controller, so nothing can drift.
    location ^~ /api/v1/ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /travian/game/deployment/public/api_legacy.php;
        fastcgi_param HTTP_AUTHORIZATION $http_authorization;
        fastcgi_pass $php_backend;
    }

    # Payment provider webhooks: raw body, no session or CSRF; the provider's
    # signature is verified in PHP. They are not part of the game's page router.
    location ~ "^/payments/(stripe|paypal)/webhook$" {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /travian/game/deployment/public/payment_webhook.php;
        fastcgi_param SCRIPT_NAME /payment_webhook.php;
        fastcgi_param PHP_SELF /payment_webhook.php;
        fastcgi_param QUERY_STRING "provider=$1";
        fastcgi_pass $php_backend;
    }

    # The reference serves the minimap as a static-looking image under /map.
    location = /map/minimap.jpg {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param PHP_SELF /index.php;
        fastcgi_param REQUEST_URI /minimap.php;
        fastcgi_param DOCUMENT_URI /minimap.php;
        fastcgi_pass $php_backend;
    }

    location ~ ^/map/block/(-?[0-9]+)\.(-?[0-9]+)\.(-?[0-9]+)\.(-?[0-9]+)\.png$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /travian/game/deployment/public/map_block.php;
        fastcgi_param SCRIPT_NAME /map_block.php;
        fastcgi_param PHP_SELF /map_block.php;
        fastcgi_param QUERY_STRING "tx0=$1&ty0=$2&tx1=$3&ty1=$4";
        fastcgi_pass $php_backend;
    }

    location ~ ^/map/mark/(-?[0-9]+)\.(-?[0-9]+)\.(-?[0-9]+)\.(-?[0-9]+)\.png$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /travian/game/deployment/public/map_mark.php;
        fastcgi_param SCRIPT_NAME /map_mark.php;
        fastcgi_param PHP_SELF /map_mark.php;
        fastcgi_param QUERY_STRING "tx0=$1&ty0=$2&tx1=$3&ty1=$4";
        fastcgi_pass $php_backend;
    }

    # The regex is quoted because nginx's config parser would otherwise split
    # the unquoted {40} quantifier into location-block braces.
    location ~ "^/heroV2/(head|body)/([0-9a-f]{40})\.([0-9]+)\.1\.png$" {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /travian/game/deployment/public/hero_v2_image.php;
        fastcgi_param SCRIPT_NAME /hero_v2_image.php;
        fastcgi_param PHP_SELF /hero_v2_image.php;
        fastcgi_param QUERY_STRING "kind=$1&hash=$2&uid=$3";
        fastcgi_pass $php_backend;
    }

    location ~ ^/heroV2/ {
        return 404;
    }

    location ~ ^/map/ {
        return 404;
    }

    location ~* \.(?:sql|log|bak|orig|lock|tmp|ini|conf|env|sh|ya?ml|dist|md|phps|inc|sqlite3?|db)$ {
        deny all;
    }

    location ~* \.(?:css|js|mjs|gif|jpe?g|png|webp|svg|ico|woff2?|ttf|eot)$ {
        try_files $uri =404;
        access_log off;
        expires 30d;

        # Static text only: build-time .gz siblings first, on-the-fly gzip for the
        # rest. Dynamic HTML is deliberately not compressed (BREACH vs CSRF tokens).
        gzip_static on;
        gzip on;
        gzip_vary on;
        gzip_types text/css application/javascript image/svg+xml application/json;
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Admin (backups, restore, mass fixes) and the installer legitimately run for a long time.
    # They get their own timeout; everything else is cut off after a minute.
    location = /admin.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param PHP_SELF /index.php;
        fastcgi_param DOCUMENT_URI /index.php;
        fastcgi_param HTTP_AUTHORIZATION $http_authorization;
        fastcgi_pass $php_long;
        fastcgi_read_timeout 3600s;
    }

    location = /setup.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/setup.php;
        fastcgi_param HTTP_AUTHORIZATION $http_authorization;
        fastcgi_pass $php_long;
        fastcgi_read_timeout 3600s;
    }

    location ~ \.php$ {
        try_files $uri /index.php?$query_string;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTP_AUTHORIZATION $http_authorization;
        fastcgi_pass $php_backend;
        fastcgi_read_timeout 60s;
    }

    location ~ /\.(?!well-known) {
        deny all;
    }
}

# Prometheus metrics, reachable only on the Compose network: port 9145 is exposed to it but never
# published, and metrics.php refuses a request without this listener's marker or without the bearer
# token from protected state (docs/operate.md, "Metrics").
server {
    listen 9145;
    server_name _;
    root /travian/game/deployment/public;
    access_log off;
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $php_backend php:9000;

    location = /metrics {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /travian/game/deployment/public/metrics.php;
        fastcgi_param SCRIPT_NAME /metrics.php;
        fastcgi_param PHP_SELF /metrics.php;
        fastcgi_param HTTP_AUTHORIZATION $http_authorization;
        fastcgi_param TRAVIAN_METRICS_LISTENER 1;
        fastcgi_pass $php_backend;
        fastcgi_read_timeout 30s;
    }

    location / {
        return 404;
    }
}
