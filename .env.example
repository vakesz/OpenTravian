# Copy to .env, or run `sh config/bootstrap-env.sh` to create it with generated
# secrets. Every variable is documented in docs/configuration.md.

# --- Required -------------------------------------------------------------------
# Generated by config/bootstrap-env.sh (openssl rand -hex 32). The setup token must
# be at least 24 characters.
MARIADB_ROOT_PASSWORD=
REDIS_PASSWORD=
TRAVIAN_SETUP_TOKEN=

# --- Common ---------------------------------------------------------------------
# Layers over compose.yaml (the production configuration). Development bind-mounts
# the checkout: COMPOSE_FILE=compose.yaml:compose.dev.yaml. Build the images locally
# with compose.build.yaml, add HTTPS with compose.tls.yaml (see docs/deploy.md).
# COMPOSE_FILE=compose.yaml:compose.dev.yaml
# Published image version to run (docs/deploy.md).
# TRAVIAN_VERSION=latest
APP_PORT=8080
APP_BIND_ADDRESS=127.0.0.1
# Public URL with a trailing slash. Leave unset locally (derived from APP_PORT, or
# from TRAVIAN_DOMAIN with compose.tls.yaml).
# TRAVIAN_BASE_URL=https://game.example.com/
# HTTPS with Caddy (compose.tls.yaml): the public domain, and TRAVIAN_TLS_INTERNAL=1
# to use Caddy's own CA for a local test such as travian.localhost.
# TRAVIAN_DOMAIN=game.example.com
# TRAVIAN_TLS_INTERNAL=1
# Optional support recipient prefill. Email delivery is optional (docs/install.md).
# TRAVIAN_SUPPORT_EMAIL=support@example.com
# Backups run daily: keep the newest N plus one per day for D days. 0 disables the
# schedule. Set the export directory to a bind-mounted host path to copy every backup.
# TRAVIAN_BACKUP_ENABLED=1
# TRAVIAN_BACKUP_KEEP_LAST=3
# TRAVIAN_BACKUP_KEEP_DAILY=7
# TRAVIAN_BACKUP_EXPORT_DIR=/exports
# After the engine was away longer than the first value, overdue work is completed in order, at most
# the second value of rows a second and for at most the third value of seconds, before the workers start.
# TRAVIAN_CATCHUP_AFTER_SECONDS=300
# TRAVIAN_CATCHUP_RATE_PER_SECOND=50
# TRAVIAN_CATCHUP_MAX_SECONDS=600
# Opt-in: also seal the generated state (SMTP, payment, social and CAPTCHA credentials, two-factor
# enrolment) into every backup with this passphrase (docs/operate.md). Keep a copy of it elsewhere.
# TRAVIAN_BACKUP_STATE_PASSPHRASE=
# Headless install, run by `docker compose up` or `docker compose run --rm installer`
# (docs/install.md). Only the Multihunter password is required.
# TRAVIAN_INSTALL_MULTIHUNTER_PASSWORD=
# TRAVIAN_INSTALL_SPEED=1
# TRAVIAN_INSTALL_PLAYER_NAME=
# TRAVIAN_INSTALL_PLAYER_PASSWORD=
# TRAVIAN_INSTALL_PLAYER_TRIBE=1
# TRAVIAN_INSTALL_TRIBES=1,2,3,6,7,8
# TRAVIAN_INSTALL_MAP_SIZE=100
# TRAVIAN_INSTALL_STARTING_GOLD=0
# TRAVIAN_INSTALL_FARM_VILLAGES=0
# TRAVIAN_INSTALL_SMTP_HOST=
# TRAVIAN_INSTALL_SMTP_PORT=587
# TRAVIAN_INSTALL_SMTP_ENCRYPTION=starttls
# TRAVIAN_INSTALL_SMTP_FROM=
# TRAVIAN_INSTALL_SMTP_AUTH=1
# TRAVIAN_INSTALL_SMTP_USERNAME=
# TRAVIAN_INSTALL_SMTP_PASSWORD=
# World rules and speed-profile overrides (docs/install.md lists the accepted values).
# TRAVIAN_INSTALL_RULE_VACATION_DAYS=
# TRAVIAN_INSTALL_RULE_START_ADVENTURES=
# TRAVIAN_INSTALL_RULE_REF_LIMIT=
# TRAVIAN_INSTALL_RULE_ALLIANCE_MEMBERS_LIMIT=
# TRAVIAN_INSTALL_RULE_REGISTER_AUTO_CLOSE=
# TRAVIAN_INSTALL_RULE_VOUCHER_ENABLED=
# TRAVIAN_INSTALL_RULE_DISABLE_SEASONS=
# TRAVIAN_INSTALL_RULE_WW_PLANS_ENABLED=
# TRAVIAN_INSTALL_RULE_FINISH_CONSTRUCTION=
# TRAVIAN_INSTALL_RULE_ONE_FARM_LIST_PER_ACCOUNT=
# TRAVIAN_INSTALL_RULE_FAKE_AUCTIONS=
# TRAVIAN_INSTALL_RULE_STARVATION=
# TRAVIAN_INSTALL_RULE_SPEED_SHORTCUTS=
# TRAVIAN_INSTALL_RULE_UPGRADE_TO_MAX_LEVEL_GOLD=
# TRAVIAN_INSTALL_RULE_SMITHY_MAX_LEVEL_GOLD=
# TRAVIAN_INSTALL_RULE_SMITHY_UPGRADE_ALL_TO_MAX_GOLD=
# TRAVIAN_INSTALL_RULE_DISCORD_URL=
# TRAVIAN_INSTALL_PROFILE_MOVEMENT_SPEED_INCREASE=
# TRAVIAN_INSTALL_PROFILE_STORAGE_MULTIPLIER=
# TRAVIAN_INSTALL_PROFILE_CRANNY_MULTIPLIER=
# TRAVIAN_INSTALL_PROFILE_TRAP_MULTIPLIER=
# TRAVIAN_INSTALL_PROFILE_CAGE_MULTIPLIER=
# TRAVIAN_INSTALL_PROFILE_PROTECTION_TIME=
# TRAVIAN_INSTALL_PROFILE_OASIS_INITIAL_PROTECTION_TIME=
# TRAVIAN_INSTALL_PROFILE_DAILY_QUEST_INTERVAL=
# TRAVIAN_INSTALL_PROFILE_HERO_REGENERATION_MULTIPLIER=
# TRAVIAN_INSTALL_PROFILE_OASIS_ANIMAL_CAP=
# TRAVIAN_INSTALL_PROFILE_OASIS_RESPAWN_INTERVAL=
# TRAVIAN_INSTALL_PROFILE_ROUND_LENGTH=

# --- Advanced -------------------------------------------------------------------
# Host user and group ids for locally built images (filled in by bootstrap-env.sh).
APP_UID=
APP_GID=
# Reverse proxy allowed to set X-Forwarded-For (an address or CIDR). Without a
# trusted proxy every player shares Docker's bridge gateway address, so IP bans and
# login throttling apply to everyone at once. compose.tls.yaml sets this for Caddy.
# TRAVIAN_TRUSTED_PROXY=127.0.0.1
# Extra host names nginx answers to (space-separated, wildcards allowed).
# TRAVIAN_EXTRA_HOSTS=
# Origin allowed to call /api from another origin.
# TRAVIAN_CORS_ORIGIN=http://localhost:8080
# Emergency break-glass for a locked-out administrator: off or optional can only lower the
# stored two-factor mode, never raise it (docs/configuration.md, administrator two-factor sign-in).
# TRAVIAN_ADMIN_TWO_FACTOR=
# Name of the database user the installer creates for the game.
# TRAVIAN_APP_DB_USER=travian
# Full image references, overriding the published ones.
# TRAVIAN_APP_IMAGE=ghcr.io/vakesz/opentravian-app:1.0.0
# TRAVIAN_WEB_IMAGE=ghcr.io/vakesz/opentravian-web:1.0.0
# Native AIO is faster on supported Linux hosts. OrbStack's VM can deny the
# io_uring permission MariaDB needs, so set this to 0 there.
TRAVIAN_MARIADB_NATIVE_AIO=1
TRAVIAN_MARIADB_BUFFER_POOL_SIZE=256M
# SSD and virtual disks. The io capacity maximum stays at MariaDB's 2000.
# TRAVIAN_MARIADB_FLUSH_NEIGHBORS=0
# TRAVIAN_MARIADB_IO_CAPACITY=1000
# Slow-query log (written inside the db container), off by default.
# TRAVIAN_MARIADB_SLOW_LOG=0
# TRAVIAN_MARIADB_SLOW_LOG_SECONDS=1
# slow.log is rotated by the db health check once it passes this many MB; this many files are kept.
# TRAVIAN_MARIADB_SLOW_LOG_MAX_MB=50
# TRAVIAN_MARIADB_SLOW_LOG_KEEP=3
# PHP-FPM pool sizing. Keep the spare-worker values within max children.
TRAVIAN_FPM_MAX_CHILDREN=8
TRAVIAN_FPM_START_SERVERS=3
TRAVIAN_FPM_MIN_SPARE_SERVERS=2
TRAVIAN_FPM_MAX_SPARE_SERVERS=5
TRAVIAN_FPM_MAX_REQUESTS=500
# Per-service memory limits and the process cap applied to every service.
# TRAVIAN_DB_MEM_LIMIT=1g
# TRAVIAN_REDIS_MEM_LIMIT=256m
# TRAVIAN_PHP_MEM_LIMIT=2g
# TRAVIAN_ENGINE_MEM_LIMIT=1g
# TRAVIAN_WEB_MEM_LIMIT=256m
# TRAVIAN_CADDY_MEM_LIMIT=128m
# TRAVIAN_PIDS_LIMIT=512
# compose.tls.yaml pins a private subnet so Caddy has a stable address.
# TRAVIAN_SUBNET=172.29.88.0/24
# TRAVIAN_CADDY_IP=172.29.88.10
# Test worlds only: let Multihunter grant gift gold.
# TRAVIAN_ALLOW_ADMIN_GOLD_GRANTS=1
